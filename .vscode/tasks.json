{
  "version": "2.0.0",
  "tasks": [
    { "label": "Qraft: setup", "type": "shell", "command": "npm run setup", "problemMatcher": [] },
    { "label": "Qraft: dev", "type": "shell", "command": "npm run dev", "isBackground": true, "problemMatcher": {
      "pattern": { "regexp": "^$" }, "background": { "activeOnStart": true, "beginsPattern": "qraft-development", "endsPattern": "Qraft: http" }
    } },
    { "label": "Qraft: build", "type": "shell", "command": "dotnet build Qraft.slnx --no-restore -m:1", "group": "build", "problemMatcher": "$msCompile" },
    { "label": "Qraft: tests", "type": "shell", "command": "npm test", "group": "test", "problemMatcher": [] },
    { "label": "Qraft: smoke", "type": "shell", "command": "npm run test:smoke", "problemMatcher": [] },
    { "label": "Qraft: stop", "type": "shell", "command": "npm run stop", "problemMatcher": [] }
  ]
}
