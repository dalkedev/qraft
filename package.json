{
  "name": "qraft-development",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12 <23" },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "node scripts/dev.mjs",
    "dev:stable": "node scripts/dev.mjs --no-watch",
    "stop": "node scripts/stop.mjs",
    "test": "dotnet test Qraft.slnx --no-restore -m:1 && npm --prefix apps/web test && npm --prefix apps/web run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:resilience": "node scripts/resilience.mjs",
    "infra:up": "docker compose --project-directory . --file infra/compose.yaml up -d --wait",
    "infra:stop": "docker compose --project-directory . --file infra/compose.yaml stop"
  }
}
